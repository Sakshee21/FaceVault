# Copy this to .env and fill in values — NEVER commit .env

# Alchemy RPC for Polygon Amoy testnet
# Get one free at https://www.alchemy.com/
POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY_HERE

# MetaMask wallet private key for deploying contracts
# Export from MetaMask: Account Details → Export Private Key
# NEVER share this or commit it to git
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
