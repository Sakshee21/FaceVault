# Database connection used by FastAPI and future SQLAlchemy models.
DATABASE_URL=sqlite:///./facevault.db

# Redis connection for Celery and background jobs.
REDIS_URL=redis://localhost:6379/0

# Polygon Mumbai or Polygon mainnet RPC endpoint.
POLYGON_RPC_URL=https://polygon-rpc.example.com

# Deployed smart contract address for consent registry queries.
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Pinata API key used for IPFS evidence uploads.
PINATA_API_KEY=your-pinata-api-key

# Pinata secret key used with the IPFS upload integration.
PINATA_SECRET_KEY=your-pinata-secret-key

# SendGrid API key for email alerts.
SENDGRID_API_KEY=your-sendgrid-api-key

# Twilio account SID for SMS alerts.
TWILIO_ACCOUNT_SID=your-twilio-account-sid

# Twilio auth token for SMS alerts.
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Minimum cosine similarity used when comparing two face embeddings.
SIMILARITY_THRESHOLD=0.4

# Secret key for app-level signing and local development.
SECRET_KEY=change-me-for-local-development